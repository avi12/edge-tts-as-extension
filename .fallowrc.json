{
  "$schema": "https://raw.githubusercontent.com/getfallow/fallow/main/schema/fallowrc.json",
  "entry": [
    "research/*.mjs",
    "src/narration-runtime/runtime.ts",
    "src/cli/narrate.ts"
  ],
  "ignorePatterns": [
    "research/edge-microsoft-voices/**"
  ],
  "ignoreDependencies": [
    "@typescript/native"
  ],
  "health": {
    "maxCognitive": 30,
    "maxCrap": 10000
  },
  "rules": {
    "unused-enum-members": "warn"
  }
}
