{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": [
    "./node_modules/fallow-config-avi12/fallow.json"
  ],
  "entry": [
    "research/*.mjs",
    "src/narration-runtime/runtime.ts",
    "src/cli/narrate.ts",
    "src/cli/render-icons.ts",
    "src/cli/build-host.ts",
    "src/narration-host/service.ts"
  ],
  "ignorePatterns": [
    "research/edge-microsoft-voices/**",
    ".claude/**"
  ],
  "ignoreDependencies": [
    "@typescript/native",
    "avi12-lint",
    "eslint-config-avi12",
    "fallow-config-avi12",
    "oxlint-config-avi12",
    "oxlint-plugin-naming",
    "stylelint-config-avi12"
  ],
  "health": {
    "maxCognitive": 30,
    "maxCrap": 10000
  },
  "rules": {
    "unused-enum-members": "warn"
  }
}
