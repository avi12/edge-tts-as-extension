{
  "name": "edge-tts-as-extension",
  "version": "1.0.0",
  "description": "Read any text aloud with Microsoft Edge's online neural voices, in Chrome",
  "repository": "https://github.com/avi12/edge-tts-as-extension",
  "author": "Avi <avi6106@gmail.com>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "tsx src/cli/dev.ts",
    "build": "wxt build",
    "zip": "wxt zip",
    "release": "tsx src/cli/release.ts",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware --fix -c .oxlintrc.fix.json && eslint --fix && oxlint --type-aware",
    "stylelint": "stylelint \"**/*.{css,svelte}\" --fix",
    "fallow": "fallow audit --base HEAD",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check": "pnpm compile && pnpm svelte:check && pnpm lint && pnpm stylelint && pnpm fallow && pnpm test",
    "postinstall": "wxt prepare",
    "narrate": "tsx src/cli/narrate.ts",
    "icons": "tsx src/cli/render-icons.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fallow": "2.103.0",
    "globals": "^17.13.0",
    "linkedom": "^0.18.13",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@webext-core/messaging": "^4.0.0",
    "zod": "4.4.3"
  }
}
