{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/oxlint-config-avi12/wxt.json",
    "./node_modules/oxlint-plugin-naming/preset.json"
  ],
  "rules": {
    "naming/convention": ["error", { "presets": ["webextension-manifest", "webextension-messages", "hook-names"] }]
  },
  "ignorePatterns": [".output/**", ".wxt/**", ".claude/**", ".dev-profile/**", "research/edge-microsoft-voices/**", "node_modules/**"]
}
