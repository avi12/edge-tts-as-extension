{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "builtin": true
  },
  "globals": {
    "browser": "readonly",
    "chrome": "readonly"
  },
  "rules": {
    "no-void": ["error", { "allowAsStatement": true }],
    "prefer-const": "error",
    "no-nested-ternary": "error",
    "curly": ["error", "all"],
    "object-shorthand": ["error", "always", { "avoidExplicitReturnArrows": true }],
    "id-length": ["error", {
      "min": 3,
      "exceptions": ["z", "_", "i", "id", "e", "ok", "to", "on", "fs", "os"],
      "properties": "never"
    }],
    "func-style": ["error", "declaration", { "allowArrowFunctions": false }],
    "arrow-body-style": ["error", "as-needed"],
    "no-control-regex": "off",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-floating-promises": "error",
    "typescript/unbound-method": "off",
    "typescript/await-thenable": "off",
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/no-unused-vars": ["error", {
      "varsIgnorePattern": "^_",
      "argsIgnorePattern": "^_",
      "caughtErrorsIgnorePattern": "^_",
      "ignoreRestSiblings": true
    }],
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "import/first": "error",
    "import/default": "off",
    "no-restricted-globals": ["error", { "name": "process", "message": "extension code does not run under Node - read config via import.meta.env, not process" }]
  },
  "overrides": [
    {
      "files": ["research/*.mjs", "src/cli/**", "eslint-rules/*.js", "**/*.config.ts", "**/*.config.js", "**/*.config.mjs", "**/*.test.ts"],
      "env": {
        "node": true
      },
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    ".output/**",
    ".wxt/**",
    ".claude/**",
    "research/edge-microsoft-voices/**"
  ]
}
