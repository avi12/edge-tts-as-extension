{
  "name": "edge-read-aloud",
  "description": "Read any text aloud with Microsoft Edge's online neural voices, in Chrome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware --fix -c .oxlintrc.fix.json && eslint --fix && oxlint --type-aware",
    "stylelint": "stylelint \"**/*.css\" --fix",
    "fallow": "fallow audit --base HEAD",
    "check": "pnpm compile && pnpm lint && pnpm stylelint && fallow dead-code --root . && pnpm test",
    "postinstall": "wxt prepare",
    "narrate": "tsx src/cli/narrate.ts"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fallow": "2.103.0",
    "globals": "^17.13.0",
    "linkedom": "^0.18.13",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
